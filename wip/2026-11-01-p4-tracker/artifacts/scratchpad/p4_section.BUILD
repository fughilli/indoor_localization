        "sdk/esp32p4/include/joltwallet__littlefs/include",
        "sdk/esp32p4/include/freertos/FreeRTOS-Kernel/include/freertos",
        "sdk/esp32p4/include/arduino_tinyusb/tinyusb/src",
        "sdk/esp32p4/include/arduino_tinyusb/include",
        "sdk/esp32p4/include/fb_gfx/include",
        "sdk/esp32p4/qio_qspi/include",
        "cores/esp32",
        "variants/esp32p4",
        "libraries/SPI/src",  # FastLED's ESP32 SPI shim includes <SPI.h>
    ],
    defines = [
        "CJSON_CIRCULAR_LIMIT=10000",
        "CJSON_NESTING_LIMIT=1000",
        "ESP32_ARDUINO_LIB_BUILDER",
        'ESP_MDNS_VERSION_NUMBER=\\"1.11.1\\"',
        "ESP_PLATFORM",
        'IDF_VER=\\"v5.5.4\\"',
        'MBEDTLS_CONFIG_FILE=\\"mbedtls/esp_config.h\\"',
        "MB_MDNS_IS_INCLUDED",
        "SOC_MMU_PAGE_SIZE=CONFIG_MMU_PAGE_SIZE",
        "SOC_XTAL_FREQ_MHZ=CONFIG_XTAL_FREQ",
        "UNITY_INCLUDE_CONFIG_H",
        "_GLIBCXX_HAVE_POSIX_SEMAPHORE",
        "_GLIBCXX_USE_POSIX_SEMAPHORE",
        "_GNU_SOURCE",
        "_POSIX_READER_WRITER_LOCKS",
        "TF_LITE_STATIC_MEMORY",
        "F_CPU=400000000L",
        "ARDUINO=10812",
        "ARDUINO_ESP32P4_DEV",
        "ARDUINO_ARCH_ESP32",
        "ARDUINO_PARTITION_default",
        'ARDUINO_BOARD=\\"ESP32P4_DEV\\"',
        'ARDUINO_VARIANT=\\"esp32p4\\"',
        "ESP32=ESP32",
        "CORE_DEBUG_LEVEL=0",
        # Serial = the USB-Serial-JTAG port (HWCDC); the HS OTG port stays free
        # for the USB host (a Vive tracker on the splanc P4 player).
        "ARDUINO_USB_MODE=1",
        "ARDUINO_USB_CDC_ON_BOOT=1",
    ],
)

_C_COPTS_ESP32P4 = [
    "-march=rv32imafc_zicsr_zifencei_xesploop_xespv",
    "-mabi=ilp32f",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wno-error=unused-function",
    "-Wno-error=unused-variable",
    "-Wno-error=unused-but-set-variable",
    "-Wno-error=deprecated-declarations",
    "-Wno-error=extra",
    "-Wno-unused-parameter",
    "-Wno-sign-compare",
    "-Wno-enum-conversion",
    "-gdwarf-4",
    "-ggdb",
    "-freorder-blocks",
    "-Wwrite-strings",
    "-fstack-protector",
    "-fstrict-volatile-bitfields",
    "-fno-jump-tables",
    "-fno-tree-switch-conversion",
    "-std=gnu17",
    "-Wno-old-style-declaration",
    "-DCHIP_HAVE_CONFIG_H",
    "-Wno-strict-prototypes",
    "-w",
]

_CXX_COPTS_ESP32P4 = [
    "-march=rv32imafc_zicsr_zifencei_xesploop_xespv",
    "-mabi=ilp32f",
    "-fno-rtti",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wno-error=unused-function",
    "-Wno-error=unused-variable",
    "-Wno-error=unused-but-set-variable",
    "-Wno-error=deprecated-declarations",
    "-Wno-error=extra",
    "-Wno-unused-parameter",
    "-Wno-sign-compare",
    "-Wno-enum-conversion",
    "-gdwarf-4",
    "-ggdb",
    "-freorder-blocks",
    "-Wwrite-strings",
    "-fstack-protector",
    "-fstrict-volatile-bitfields",
    "-fno-jump-tables",
    "-fno-tree-switch-conversion",
    "-std=gnu++2b",
    "-fexceptions",
    "-fuse-cxa-atexit",
    "-std=gnu++2a",
    "-DCHIP_HAVE_CONFIG_H",
    "-w",
]

cc_library(
    name = "core_c_esp32p4",
    srcs = glob(["cores/esp32/**/*.c", "variants/esp32p4/**/*.c"], allow_empty = True),
    copts = _C_COPTS_ESP32P4,
    alwayslink = True,
    deps = [":sdk_hdrs_esp32p4"],
)

cc_library(
    name = "core_cpp_esp32p4",
    srcs = glob(["cores/esp32/**/*.cpp", "variants/esp32p4/**/*.cpp", "libraries/SPI/**/*.cpp"], allow_empty = True),
    copts = _CXX_COPTS_ESP32P4,
    alwayslink = True,
    deps = [":sdk_hdrs_esp32p4"],
)

cc_library(
    name = "core_esp32p4",
    additional_linker_inputs = [
        ":sdk_link_dirs_esp32p4", ":sdk_libs_esp32p4", ":sdk_ld_esp32p4",
        ":ld_flags_esp32p4", ":ld_scripts_esp32p4", ":ld_libs_esp32p4",
    ],
    linkopts = [
        "@$(location :sdk_link_dirs_esp32p4)",
        "@$(location :ld_flags_esp32p4)",
        "@$(location :ld_scripts_esp32p4)",
        "-Wl,--wrap=esp_panic_handler",
        "-Wl,--start-group",
        "@$(location :ld_libs_esp32p4)",
        "-Wl,--end-group",
        "-Wl,-EL",
    ],
    deps = [":core_c_esp32p4", ":core_cpp_esp32p4", ":sdk_hdrs_esp32p4"],
)

