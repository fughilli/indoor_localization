# Swarm loader: the factory app that installs staged images into main and,
# when main can't run, joins the swarm to receive a new one
# (docs/swarm-network.md "Boot flow").
load("@firmware//rules:firmware.bzl", "firmware_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "loader",
    srcs = ["loader.cpp"],
    target_compatible_with = select({
        "@firmware//platforms:is_esp32": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//apps/common:boot",
        "//apps/common:fw_key",
        "//apps/common:netcmd",
        "//apps/common:netstore",
        "//apps/common:radio",
        "//apps/common:store",
        "//apps/common:swarm_crypto",
        "//swarm/loader_rs:loader_rs_fw",
        "//swarm/net:header",
    ],
)

firmware_binary(
    name = "loader_esp32",
    binary = ":loader",
    board = "esp32",
)
