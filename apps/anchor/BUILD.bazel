# UWB anchors: one binary per station, ANCHOR_ID baked in at compile time.
# Flash with e.g.: bazel run //apps/anchor:flash_anchor_1 -- --port /dev/ttyUSB0
load("@firmware//rules:firmware.bzl", "firmware_binary")
load("@firmware//rules:flash.bzl", "esptool_flash")

package(default_visibility = ["//visibility:public"])

[
    (
        cc_binary(
            name = "anchor_%d" % anchor_id,
            srcs = ["anchor.cpp"],
            local_defines = ["ANCHOR_ID=%d" % anchor_id],
            # Only built via firmware_binary's transition; skipped otherwise.
            target_compatible_with = select({
                "@firmware//platforms:is_esp32": [],
                "//conditions:default": ["@platforms//:incompatible"],
            }),
            deps = ["//libs/dw3000"],
        ),
        firmware_binary(
            name = "anchor_%d_esp32" % anchor_id,
            binary = ":anchor_%d" % anchor_id,
            board = "esp32",
        ),
        esptool_flash(
            name = "flash_anchor_%d" % anchor_id,
            app = ":anchor_%d_esp32" % anchor_id,
            bootloader = "@firmware//libs/board:esp32_bootloader_bin",
            bootloader_offset = "0x1000",  # classic ESP32 ROM loads from 0x1000
            chip = "esp32",
        ),
    )
    for anchor_id in [1, 2, 3]
]
