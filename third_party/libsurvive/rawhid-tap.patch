 #include <assert.h>
 #include <errno.h>
 #include <hidapi.h>
+#include <os_generic.h>
+#include <stdio.h>
 #include <survive.h>
+
+#include "survive_recording.h"
+
+STATIC_CONFIG_ITEM(RECORD_RAWHID, "record-rawhid", 'b',
+				   "Record every HID report exactly as hidapi delivers it (HIDIN) and every feature report "
+				   "exchanged (HIDFEAT), hex, with the host receive time in us",
+				   0)
+
+/**
+ * Raw HID tap. One line per report, so a recording holds every byte the device sent while it ran:
+ *
+ *   <t> <dev> HIDIN <interface> <host_us> <len> <hex>
+ *   <t> <dev> HIDFEAT <GET|SET> <host_us> <rtn> <hex>
+ *
+ * <interface> is libsurvive's name for it (IMU, Lightcap, Buttons, ...); <host_us> is
+ * OGGetAbsoluteTimeUS() when hidapi returned the report; for HIDFEAT, <rtn> is hidapi's return
+ * (bytes transferred, or -1) and <hex> the buffer after the call (GET) or the one sent (SET).
+ */
+static void hid_tap(SurviveContext *ctx, const char *dev, const char *what, const char *sub, uint64_t host_us,
+					int len, const uint8_t *data, int datalen) {
+	static int enabled = -1;
+	if (!ctx || !ctx->recptr)
+		return;
+	if (enabled == -1)
+		enabled = survive_configi(ctx, "record-rawhid", SC_GET, 0);
+	if (!enabled)
+		return;
+	char hex[2 * 1024 + 1];
+	if (datalen > 1024)
+		datalen = 1024;
+	static const char digits[] = "0123456789abcdef";
+	for (int i = 0; i < datalen; i++) {
+		hex[2 * i] = digits[data[i] >> 4];
+		hex[2 * i + 1] = digits[data[i] & 15];
+	}
+	hex[2 * (datalen > 0 ? datalen : 0)] = 0;
+	// The recording writer prints the time and the body separately; keep the line whole.
+	flockfile(stdout);
+	survive_recording_write_to_output(ctx->recptr, "%s %s %s %llu %d %s\n", dev, what, sub,
+									  (unsigned long long)host_us, len, hex);
+	funlockfile(stdout);
+}
+
+static const char *usb_dev_name(struct SurviveUSBInfo *usbInfo) {
+	if (usbInfo->so && usbInfo->so->codename[0])
+		return usbInfo->so->codename;
+	return usbInfo->device_info && usbInfo->device_info->codename[0] ? usbInfo->device_info->codename : "USB";
+}
 #define LIBUSB_TRANSFER_COMPLETED 0
 #define LIBUSB_TRANSFER_STALL -1
 #define LIBUSB_TRANSFER_TIMED_OUT -2
