+static uint32_t median_u32(uint32_t *v, int n) {
+	for (int i = 1; i < n; i++) {
+		uint32_t x = v[i];
+		int j = i - 1;
+		for (; j >= 0 && v[j] > x; j--)
+			v[j + 1] = v[j];
+		v[j + 1] = x;
+	}
+	return n ? v[n / 2] : 0;
+}
+
+/**
+ * Finds the largest set of pulses that start within SYNC_COINCIDENCE of one another, counting each
+ * sensor once. Returns the number of distinct sensors in it and, through `out`, a synthetic element
+ * with the median start and median length of that set (sensor_id = 0xff). Starts are compared
+ * relative to the first pulse so 32-bit timecode rollover doesn't matter.
+ */
+static uint32_t calculate_error(int target_acode, const LightcapElement *le);
+static void group_at(const PulseSet *set, int anchor, LightcapElement *out);
+
+static int coincident_group_for(const PulseSet *set, int target_acode, LightcapElement *out) {
+	int best_count = 0, best_anchor = -1;
+	uint32_t best_error = UINT32_MAX;
+	for (int i = 0; i < set->count; i++) {
+		uint64_t seen = 0;
+		int count = 0;
+		for (int j = 0; j < set->count; j++) {
+			int32_t dt = (int32_t)(set->e[j].timestamp - set->e[i].timestamp);
+			if (dt < 0 || dt > SYNC_COINCIDENCE)
+				continue;
+			uint64_t bit = 1ull << (set->e[j].sensor_id & 63);
+			if (!(seen & bit)) {
+				seen |= bit;
+				count++;
+			}
+		}
+		// Most sensors wins; on a tie (single-sensor syncs on wireless links, a stray pulse in the
+		// window) the one whose length best matches the code expected here.
+		uint32_t error = 0;
+		if (target_acode >= 0 && count == best_count) {
+			LightcapElement g;
+			group_at(set, i, &g);
+			error = calculate_error(target_acode, &g);
+		}
+		if (count > best_count || (count == best_count && target_acode >= 0 && error < best_error)) {
+			best_count = count;
+			best_anchor = i;
+			if (target_acode >= 0) {
+				LightcapElement g;
+				group_at(set, i, &g);
+				best_error = calculate_error(target_acode, &g);
+			}
+		}
+	}
+	if (best_anchor < 0)
+		return 0;
+	if (out)
+		group_at(set, best_anchor, out);
+	return best_count;
+}
+
+static int coincident_group(const PulseSet *set, LightcapElement *out) { return coincident_group_for(set, -1, out); }
+
+/** Median start and length of the pulses starting within SYNC_COINCIDENCE after pulse `anchor`. */
+static void group_at(const PulseSet *set, int anchor, LightcapElement *out) {
+	uint32_t starts[MAX_PULSE_ELEMENTS], lengths[MAX_PULSE_ELEMENTS];
+	int n = 0;
+	uint32_t base = set->e[anchor].timestamp;
+	for (int j = 0; j < set->count; j++) {
+		int32_t dt = (int32_t)(set->e[j].timestamp - base);
+		if (dt < 0 || dt > SYNC_COINCIDENCE)
+			continue;
+		starts[n] = (uint32_t)dt;
+		lengths[n] = set->e[j].length;
+		n++;
+	}
+	out->timestamp = base + median_u32(starts, n);
+	out->length = (uint16_t)median_u32(lengths, n);
+	out->sensor_id = 0xff;
+}
