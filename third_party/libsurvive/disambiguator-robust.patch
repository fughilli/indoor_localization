+	int judged = 0, disagree = 0;
+	for (int i = 0; i < so->sensor_ct; i++) {
+		SweepCandidates *c = &d->sweep_data[i];
+		int longest = -1;
+		for (int k = 0; k < c->count; k++)
+			if (longest < 0 || c->e[k].length > c->e[longest].length)
+				longest = k;
+		chosen[i] = longest >= 0 ? c->e[longest] : (LightcapElement){0};
+		if (!predict || c->count == 0)
+			continue;
+
+		SurviveAngleReading pred;
+		survive_reproject_full(ctx->bsd[lh].fcal, &world2lh, &so->OutPoseIMU, so->sensor_locations + 3 * i, pred);
+		int best = -1;
