# Shared DWM3000 UWB transceiver driver (register-level, SPI). Used by both
# the anchor and tag apps; only built under the esp32 board transition.
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "dw3000",
    srcs = ["dw3000.cpp"],
    hdrs = ["dw3000.h"],
    target_compatible_with = select({
        "@firmware//platforms:is_esp32": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@firmware//libs/board:arduino_core"],
)
