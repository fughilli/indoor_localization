# Sensor characterization tooling: capture/manifest formats, analysis
# numerics (AoA plane fit, range stats, IMU Allan deviation, mag ellipsoid
# calibration), synthetic capture generation, and the characterize CLI.
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "records_lib",
    srcs = ["records.py"],
)

py_library(
    name = "analysis_lib",
    srcs = ["analysis.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//scipy",
    ],
)

py_library(
    name = "synth_lib",
    srcs = ["synth.py"],
    deps = [
        ":analysis_lib",
        "@pypi//numpy",
    ],
)

py_library(
    name = "characterize_lib",
    srcs = ["characterize.py"],
    deps = [
        ":analysis_lib",
        ":records_lib",
        ":synth_lib",
        ":widget_config_lib",
    ],
)

py_binary(
    name = "characterize",
    srcs = ["characterize.py"],
    main = "characterize.py",
    deps = [":characterize_lib"],
)

py_library(
    name = "widget_config_lib",
    srcs = ["widget_config.py"],
    deps = [
        "//swarm/proto:widget_config_py_proto",
        "@pypi//numpy",
        "@pypi//protobuf",
    ],
)

py_binary(
    name = "widget_config_tool",
    srcs = ["widget_config.py"],
    main = "widget_config.py",
    deps = [":widget_config_lib"],
)

# Reference binary proto from the example config: the cross-language
# contract — Python (canonical protobuf) encodes it here, the on-device
# micropb bindings prove byte-identical round-trip
# (//swarm/config:widget_config_test).
genrule(
    name = "example_config_binpb",
    srcs = ["examples/widget_v1.txtpb"],
    outs = ["examples/widget_v1.binpb"],
    cmd = "$(location :widget_config_tool) export-binpb " +
          "--config $(location examples/widget_v1.txtpb) --out $@",
    tools = [":widget_config_tool"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "widget_config_test",
    srcs = ["widget_config_test.py"],
    data = ["examples/widget_v1.txtpb"],
    deps = [
        ":analysis_lib",
        ":records_lib",
        ":synth_lib",
        ":widget_config_lib",
    ],
)

py_library(
    name = "extrinsics_configurator_lib",
    srcs = ["extrinsics_configurator.py"],
    data = ["examples/widget_v1.txtpb"],
    deps = [":widget_config_lib"],
)

py_binary(
    name = "extrinsics_configurator",
    srcs = ["extrinsics_configurator.py"],
    main = "extrinsics_configurator.py",
    deps = [":extrinsics_configurator_lib"],
)

py_test(
    name = "extrinsics_configurator_test",
    srcs = ["extrinsics_configurator_test.py"],
    data = ["examples/widget_v1.txtpb"],
    deps = [":extrinsics_configurator_lib"],
)

py_test(
    name = "analysis_test",
    size = "medium",
    srcs = ["analysis_test.py"],
    deps = [
        ":analysis_lib",
        ":records_lib",
        ":synth_lib",
    ],
)

# Serial capture recorder. Runs on the host the board is plugged into
# (`python3 swarm/tools/capture.py ...`, needs pyserial); only its parsing and
# manifest helpers are tested here.
py_library(
    name = "capture_lib",
    srcs = ["capture.py"],
)

py_test(
    name = "capture_test",
    srcs = ["capture_test.py"],
    deps = [
        ":capture_lib",
        ":records_lib",
    ],
)

# Live ranging web view (host-run like capture.py: `python3
# swarm/tools/range_view.py --port ...`, needs pyserial); hub logic tested here.
py_library(
    name = "range_view_lib",
    srcs = ["range_view.py"],
    deps = [":capture_lib"],
)

py_test(
    name = "range_view_test",
    srcs = ["range_view_test.py"],
    deps = [
        ":range_view_lib",
        ":records_lib",
    ],
)

# Swarm web view through any one node (host-run: `python3
# swarm/tools/swarm_view.py --port ...`, needs pyserial).
py_library(
    name = "swarm_view_lib",
    srcs = ["swarm_view.py"],
    deps = [
        ":capture_lib",
        ":range_view_lib",
    ],
)

# Synthetic node capture (sim-driven) for swarm_view --replay.
py_binary(
    name = "swarm_view_demo",
    srcs = ["swarm_view_demo.py"],
    deps = ["//swarm/sim:world_lib"],
)

# Swarm network wire formats (host side of swarm/net) + the control tool.
py_library(
