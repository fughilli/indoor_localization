# Sensor characterization tooling: capture/manifest formats, analysis
# numerics (AoA plane fit, range stats, IMU Allan deviation, mag ellipsoid
# calibration), synthetic capture generation, and the characterize CLI.
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "records_lib",
    srcs = ["records.py"],
)

py_library(
    name = "analysis_lib",
    srcs = ["analysis.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//scipy",
    ],
)

py_library(
    name = "synth_lib",
    srcs = ["synth.py"],
    deps = [
        ":analysis_lib",
        "@pypi//numpy",
    ],
)

py_library(
    name = "characterize_lib",
    srcs = ["characterize.py"],
    deps = [
        ":analysis_lib",
        ":intrinsics_lib",
        ":records_lib",
        ":synth_lib",
    ],
)

py_binary(
    name = "characterize",
    srcs = ["characterize.py"],
    main = "characterize.py",
    deps = [":characterize_lib"],
)

py_library(
    name = "extrinsics_lib",
    srcs = ["extrinsics.py"],
    deps = ["@pypi//numpy"],
)

py_binary(
    name = "extrinsics",
    srcs = ["extrinsics.py"],
    main = "extrinsics.py",
    deps = [":extrinsics_lib"],
)

# Reference blob from the example config: the cross-language contract —
# Python encodes it here, the on-device Rust parser proves it can read it
# (//swarm/core:swarm_core_test).
genrule(
    name = "example_extrinsics_blob",
    srcs = ["examples/widget_v1.json"],
    outs = ["examples/widget_v1.wext"],
    cmd = "$(location :extrinsics) export-blob " +
          "--config $(location examples/widget_v1.json) --out $@",
    tools = [":extrinsics"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "extrinsics_test",
    srcs = ["extrinsics_test.py"],
    data = ["examples/widget_v1.json"],
    deps = [":extrinsics_lib"],
)

py_library(
    name = "intrinsics_lib",
    srcs = ["intrinsics.py"],
)

py_binary(
    name = "intrinsics",
    srcs = ["intrinsics.py"],
    main = "intrinsics.py",
    deps = [":intrinsics_lib"],
)

genrule(
    name = "example_intrinsics_blob",
    srcs = ["examples/widget_v1_intrinsics.json"],
    outs = ["examples/widget_v1_intrinsics.wint"],
    cmd = "$(location :intrinsics) export-blob " +
          "--config $(location examples/widget_v1_intrinsics.json) --out $@",
    tools = [":intrinsics"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "intrinsics_test",
    srcs = ["intrinsics_test.py"],
    data = ["examples/widget_v1_intrinsics.json"],
    deps = [
        ":analysis_lib",
        ":intrinsics_lib",
        ":records_lib",
        ":synth_lib",
    ],
)

py_library(
    name = "extrinsics_configurator_lib",
    srcs = ["extrinsics_configurator.py"],
    data = ["examples/widget_v1.json"],
    deps = [":extrinsics_lib"],
)

py_binary(
    name = "extrinsics_configurator",
    srcs = ["extrinsics_configurator.py"],
    main = "extrinsics_configurator.py",
    deps = [":extrinsics_configurator_lib"],
)

py_test(
    name = "extrinsics_configurator_test",
    srcs = ["extrinsics_configurator_test.py"],
    data = ["examples/widget_v1.json"],
    deps = [":extrinsics_configurator_lib"],
)

py_test(
    name = "analysis_test",
    size = "medium",
    srcs = ["analysis_test.py"],
    deps = [
        ":analysis_lib",
        ":records_lib",
        ":synth_lib",
    ],
)
