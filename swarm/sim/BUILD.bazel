# Station-free swarm simulation: Python harness around the Rust estimator
# (one instance per widget) with sensor/network models and a web viewer.
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "estimator_lib",
    srcs = ["estimator.py"],
    data = ["//swarm/core:swarm_core_cdylib"],
)

py_test(
    name = "estimator_test",
    srcs = ["estimator_test.py"],
    deps = [":estimator_lib"],
)

py_library(
    name = "node_backend_lib",
    srcs = ["node_backend.py"],
    data = ["//swarm/node:swarm_node_sim"],
)

py_library(
    name = "world_lib",
    srcs = ["world.py"],
    deps = [
        ":estimator_lib",
        ":node_backend_lib",
        "@pypi//numpy",
    ],
)

py_library(
    name = "run_sim_lib",
    srcs = ["run_sim.py"],
    deps = [
        ":world_lib",
        "//swarm/tools:widget_config_lib",
        "@pypi//numpy",
    ],
)

py_binary(
    name = "run_sim",
    srcs = ["run_sim.py"],
    main = "run_sim.py",
    deps = [":run_sim_lib"],
)

py_library(
    name = "viewer_lib",
    srcs = ["viewer.py"],
    deps = [":world_lib"],
)

py_binary(
    name = "viewer",
    srcs = ["viewer.py"],
    main = "viewer.py",
    deps = [":viewer_lib"],
)

py_test(
    name = "viewer_test",
    srcs = ["viewer_test.py"],
    deps = [":viewer_lib"],
)

py_test(
    name = "sim_test",
    size = "large",
    srcs = ["sim_test.py"],
    deps = [":run_sim_lib"],
)

py_binary(
    name = "trace_room",
    srcs = ["trace_room.py"],
    deps = [":run_sim_lib"],
)

# Reflector / fader estimation against the UWB mesh: the multipath channel +
# PDoA array model, the P1 (map) and P2 (locate the mesh) solvers, and the tier
# comparison (docs/uwb-landmarks.md). Pure numpy/scipy; world_lib only for the
# closed-form widget trajectories.
py_library(
    name = "multipath_lib",
    srcs = ["multipath.py"],
    deps = [
        ":world_lib",
        "@pypi//numpy",
    ],
)

py_library(
    name = "landmarks_lib",
    srcs = ["landmarks.py"],
    deps = [
        ":multipath_lib",
        "@pypi//numpy",
        "@pypi//scipy",
    ],
)

py_binary(
    name = "landmarks_run",
    srcs = ["landmarks_run.py"],
    main = "landmarks_run.py",
    deps = [
        ":landmarks_lib",
        ":multipath_lib",
        ":world_lib",
    ],
)

py_test(
    name = "landmarks_test",
    size = "medium",
    srcs = [
        "landmarks_run.py",
        "landmarks_test.py",
    ],
    main = "landmarks_test.py",
    deps = [
        ":landmarks_lib",
        ":multipath_lib",
        ":world_lib",
    ],
)
