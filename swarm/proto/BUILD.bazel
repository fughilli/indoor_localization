# widget.v1 config schema: one .proto, three consumers — Python tools
# (protoc --python_out + pip protobuf runtime), no_std Rust for firmware
# (micropb), and textproto/JSON forms handled by the Python tools. The
# codegen base (hermetic protoc, micropb runtime + generator) comes from the
# embedded module: @firmware//proto.
load("@rules_python//python:defs.bzl", "py_library")
load("@firmware//proto:micropb.bzl", "micropb_rust_library", "proto_fdset", "proto_py_gen")
load("@pbview//:defs.bzl", "pbview_cc_library")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files(["widget_config.proto"])

proto_py_gen(
    name = "widget_config_py_gen",
    proto = "widget_config.proto",
)

py_library(
    name = "widget_config_py_proto",
    srcs = [":widget_config_py_gen"],
    imports = ["."],
    deps = ["@pypi//protobuf"],
)

micropb_rust_library(
    name = "widget_pb",
    gen_main = "gen_main.rs",
    profile = "host",
    proto = "widget_config.proto",
)

# The same schema as zero-copy C++ views for the C++ firmware (pbview): parse a received
# buffer in place, no decoded struct. See docs/pbview.md.
proto_fdset(
    name = "widget_config_fdset",
    proto = "widget_config.proto",
)

pbview_cc_library(
    name = "widget_views",
    fdset = ":widget_config_fdset",
    header = "widget_config_views.h",
)

cc_test(
    name = "widget_views_test",
    srcs = ["widget_views_test.cc"],
    copts = ["-std=c++17", "-Wall", "-Wextra", "-Werror", "-fno-exceptions", "-fno-rtti"],
    deps = [":widget_views"],
)

# swarm.v1: every node-to-node / node-to-host structure (swarm_wire.proto). C++ reads the link
# layer in place with pbview, Python with protoc, Rust (swarm_net) with micropb; see
# docs/swarm-wire.md.
exports_files(["swarm_wire.proto"])

proto_fdset(
    name = "swarm_wire_fdset",
    proto = "swarm_wire.proto",
)

pbview_cc_library(
    name = "swarm_wire_views",
    fdset = ":swarm_wire_fdset",
    header = "swarm_wire_views.h",
)

proto_py_gen(
    name = "swarm_wire_py_gen",
    proto = "swarm_wire.proto",
)

py_library(
    name = "swarm_wire_py_proto",
    srcs = [":swarm_wire_py_gen"],
    imports = ["."],
    deps = ["@pypi//protobuf"],
)
