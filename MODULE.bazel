"""UWB indoor positioning system (ESP32-WROOM + Qorvo DWM3000).

Firmware (3 anchors + 1 tag) builds on the `firmware` bzlmod module vendored at
third_party/embedded — Nix supplies the xtensa cross toolchain and the
arduino-esp32 core; Bazel compiles/links with native cc_* rules. Host-side
positioning software (TCP ingest + trilateration + web floor view) is added
under //host with rules_python.
"""

module(
    name = "uwb_rtls",
    version = "0.0.0",
)

bazel_dep(name = "firmware", version = "0.0.0")
local_path_override(
    module_name = "firmware",
    path = "third_party/embedded",
)

# Hermetic Python for //host (solver/server/simulator). Deps flow from
# requirements.in via the rules_uv regen target (bazel run
# //:generate_requirements_lock) into requirements.lock, consumed by pip.parse.
bazel_dep(name = "rules_python", version = "2.0.3")
bazel_dep(name = "rules_uv", version = "0.86.0")

PYTHON_VERSION = "3.11"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

# Hermetic Rust for //swarm (station-free cooperative localization core).
# The estimator is pure Rust with no crate deps and a C ABI so the same code
# ports to the embedded target; the Python sim binds it via ctypes.
bazel_dep(name = "rules_rust", version = "0.71.3")

# The classic ESP32 (esp-rs, xtensa-esp32-none-elf) as a known rules_rust
# triple, so crate_universe crates resolve for it. See the patch header.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//patches:rules_rust_xtensa.patch"],
    version = "0.71.3",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # 1.85.0: matches the firmware module's toolchain and the validated MSRV
    # for the micropb 0.5.1 runtime + generator line.
    versions = ["1.85.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Crates for //swarm Rust that runs on host AND firmware. Just libm: pure
# Rust float math for no_std, used on both sides so sim and device match
# bit for bit. The triple list extends rules_rust's host-centric default with
# the classic ESP32 (esp-rs toolchain, @firmware//toolchains/rust/esp32).
# Repin: CARGO_BAZEL_REPIN=1 bazelisk query @swarm_crates//:libm
swarm_crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
swarm_crate.spec(
    default_features = False,
    package = "libm",
    version = "0.2.11",
)
swarm_crate.spec(
    default_features = False,
    package = "sha2",
    version = "0.10.8",
)
swarm_crate.spec(
    default_features = False,
    package = "hmac",
    version = "0.12.1",
)
swarm_crate.spec(
    default_features = False,
    features = ["ecdsa"],
    package = "p256",
    version = "0.13.2",
)
swarm_crate.from_specs(
    name = "swarm_crates",
    cargo_lockfile = "//swarm:crates-Cargo.lock",
    lockfile = "//swarm:crates-lock.json",
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "xtensa-esp32-none-elf",
    ],
)
use_repo(swarm_crate, "swarm_crates")

# Lighthouse (Vive Tracker) tracking: kernel, protocol, device (no_std), lhd and
# the tools, from fughilli/lighthouse (moved out of this repo so Splanc's ESP32-P4
# player can pin it too). lhd: bazel build -c opt @lighthouse//daemon:lhd
bazel_dep(name = "lighthouse", version = "0.0.0")
archive_override(
    module_name = "lighthouse",
    integrity = "sha256-8KeGlT7pzwdNLef7lhSrY6z3Dh94V+n5u6gwwPRVEKw=",
    strip_prefix = "lighthouse-4919232c4e350efcfe4dd6e49a83929cdf046c4f",
    urls = ["https://github.com/fughilli/lighthouse/archive/4919232c4e350efcfe4dd6e49a83929cdf046c4f.tar.gz"],
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:requirements.lock",
)
use_repo(pip, "pypi")
