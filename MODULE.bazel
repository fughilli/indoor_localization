"""UWB indoor positioning system (ESP32-WROOM + Qorvo DWM3000).

Firmware (3 anchors + 1 tag) builds on the `firmware` bzlmod module vendored at
third_party/embedded — Nix supplies the xtensa cross toolchain and the
arduino-esp32 core; Bazel compiles/links with native cc_* rules. Host-side
positioning software (TCP ingest + trilateration + web floor view) is added
under //host with rules_python.
"""

module(
    name = "uwb_rtls",
    version = "0.0.0",
)

bazel_dep(name = "firmware", version = "0.0.0")
local_path_override(
    module_name = "firmware",
    path = "third_party/embedded",
)

# Hermetic Python for //host (solver/server/simulator). Deps flow from
# requirements.in via the rules_uv regen target (bazel run
# //:generate_requirements_lock) into requirements.lock, consumed by pip.parse.
bazel_dep(name = "rules_python", version = "2.0.3")
bazel_dep(name = "rules_uv", version = "0.86.0")

PYTHON_VERSION = "3.11"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:requirements.lock",
)
use_repo(pip, "pypi")
